# PrioritizeMail AI - Configurações

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações de IA (Opcional - pode ser inserido na interface também)
GEMINI_API_KEY=

# Configurações de E-mail IMAP (Opcional - pode ser configurado via interface)
IMAP_USER=seu_email@gmail.com
IMAP_PASSWORD=sua_senha_de_app
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
